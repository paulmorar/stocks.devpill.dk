{
  "name": "stock-scout",
  "version": "0.1.0",
  "description": "Score stocks for long-term investing and spot short-term setups, explained for experts and beginners.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "NODE_OPTIONS=--conditions=react-server tsx scripts/scan.ts",
    "universe": "tsx scripts/update-universe.ts",
    "calibrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/calibrate.ts",
    "auth": "tsx scripts/auth.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
