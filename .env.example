# Optional second data source. Fills in statement history Yahoo doesn't return
# (Yahoo usually gives ~4 fiscal years; the 10-year checks need more).
# Free key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Set to 1 to serve built-in synthetic sample companies instead of live data.
# Handy for UI work offline. Never shows real prices.
DEMO_MODE=0

# ── Login (required in production; local dev stays open without these) ──
# Signs session cookies. Generate with: npm run auth -- secret
AUTH_SECRET=

# GitHub SSO. Create an OAuth App at github.com/settings/developers with
# callback URL https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Verified GitHub emails allowed in, comma-separated. Checked on every request.
AUTH_ALLOWED_EMAILS=
# Optional: pin the public URL used for the GitHub callback (defaults to the request's host).
APP_URL=

# Optional password fallback (e.g. for someone without GitHub).
# Generate an entry with: npm run auth -- user <name>   →  name:scrypt.<salt>.<hash>
AUTH_USERS=

# Set to 1 to turn login off entirely (not recommended on a public URL).
AUTH_DISABLED=0
