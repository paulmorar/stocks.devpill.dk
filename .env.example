# Optional second data source. Fills in statement history Yahoo doesn't return
# (Yahoo usually gives ~4 fiscal years; the 10-year checks need more).
# Free key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Set to 1 to serve built-in synthetic sample companies instead of live data.
# Handy for UI work offline. Never shows real prices.
DEMO_MODE=0
